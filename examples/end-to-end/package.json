{
  "name": "elm-pages-example",
  "type": "module",
  "version": "1.0.0",
  "description": "Example site built with elm-pages.",
  "scripts": {
    "start": "elm-pages dev",
    "serve": "npm run build && http-server ./dist -a localhost -p 3000 -c-1",
    "build": "elm-pages build",
    "test:frozen-views": "elm-pages build --debug && node check-frozen-views.mjs",
    "serve:dist": "node serve-dist.mjs",
    "cypress:production": "cypress run --config-file cypress.production.config.js",
    "cypress:dev-default": "cypress run --config-file cypress.dev-default.config.js"
  },
  "author": "Dillon Kearns",
  "license": "BSD-3",
  "devDependencies": {
    "cypress": "^16.2.1",
    "elm-pages": "file:../..",
    "elm-tooling": "^1.15.1",
    "http-server": "^14.1.1"
  }
}
